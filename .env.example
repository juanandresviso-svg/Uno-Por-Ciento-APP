# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # solo servidor, nunca en el cliente

# Solo este correo puede entrar a la app
ALLOWED_EMAIL=juanandresviso@gmail.com

# Web Push (genera con: npm run vapid)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:juanandresviso@gmail.com

# Resend (resend.com → API Keys). Mientras no verifiques dominio usa onboarding@resend.dev
RESEND_API_KEY=re_...
EMAIL_FROM="Uno por Ciento <onboarding@resend.dev>"

# Clave que usa el cron de Supabase para llamar /api/cron/tick
CRON_SECRET=pon-aqui-una-cadena-larga-aleatoria

# URL pública de la app (para links en los correos)
NEXT_PUBLIC_APP_URL=https://uno-por-ciento.vercel.app
